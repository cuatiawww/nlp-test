# Shared development environment variables for the Disease Surveillance AI stack.
# Sourced by .cursor/install.sh, .cursor/start.sh, and each service terminal.
# Native (non-Docker) local development wiring. No secrets belong in this file.

# --- Postgres + PostGIS ---
export DATABASE_URL="postgres://postgres:root@127.0.0.1:5432/disease_ai"

# --- RabbitMQ ---
export RABBITMQ_URL="amqp://guest:guest@127.0.0.1:5672/%2f"

# --- Service URLs (native ports) ---
export NLP_SERVICE_URL="http://127.0.0.1:8001"
export COLLECTOR_URL="http://127.0.0.1:8002"
export BACKEND_INTERNAL_URL="http://127.0.0.1:8081"
export BACKEND_LABELS_URL="http://127.0.0.1:8081"

# --- Rust backend ---
export BACKEND_PORT=8081
# Dev-only token; real deployments inject a strong secret via the secrets panel.
export API_TOKEN=devtoken

# --- NLP service ---
# "none" skips the ~1GB+ transformer downloads; the DB-driven keyword pipeline
# still classifies known diseases. Set to xlm-roberta/fine-tuned for full ML.
export NLP_MODEL=none
# Skip the ~2GB NLLB translation model download for local development.
export TRANSLATION_LOCAL_ENABLED=false

# --- Web UI admin login (dev only) ---
# The upstream deploy seeds this via a separate "init" service that is not in
# the repo. install.sh seeds a webmaster/admin user with this password so the
# authenticated pages are usable locally. Not a real secret.
export WEBMASTER_PASSWORD=demo1234

# --- Frontend (Next.js, basePath /nlp) ---
export NEXT_PUBLIC_BASE_PATH="/nlp"
export NEXT_PUBLIC_API_BASE_URL="http://localhost:3010/nlp"
export PORT=3010
