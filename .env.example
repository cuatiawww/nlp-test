# PostgreSQL + PostGIS
POSTGRES_DB=disease_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/disease_ai

# Webmaster login password (for web UI, not PostgreSQL)
WEBMASTER_PASSWORD=CHANGE_ME_TOO

# Backend
BACKEND_PORT=8080
RUST_LOG=info
NLP_SERVICE_URL=http://nlp-python:8000
API_INTERNAL_URL=http://backend-rust:8080
BACKEND_INTERNAL_URL=http://backend-rust:8081
COLLECTOR_URL=http://collector-python:8002
API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# CORS allowlist (comma-separated). Do not use wildcard in production.
CORS_ALLOWED_ORIGINS=https://abvc-surveillance.org,http://localhost:3010,http://127.0.0.1:3010

# Only use for official hosts with a known broken certificate chain. Keep empty
# by default; this is an explicit host exception, not a global TLS bypass.
CRAWLER_INSECURE_TLS_HOSTS=

# NLP case extraction: never invent a case when parsing fails.
DEFAULT_CASE_COUNT=0
MAX_EVENT_CASE_COUNT=2000000
MAX_EVENT_DEATH_COUNT=200000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_BASE_PATH=/nlp

# MinIO
MINIO_ROOT_USER=minio_mci
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=disease-documents

# RabbitMQ
RABBITMQ_DEFAULT_USER=disease_app
RABBITMQ_DEFAULT_PASS=CHANGE_ME
RABBITMQ_URL=amqp://disease_app:CHANGE_ME@rabbitmq:5672/%2f
RABBITMQ_QUEUE=disease.raw
RABBITMQ_ANALYSIS_URL_QUEUE=disease.analysis-url
RABBITMQ_CRAWL_MATRIX_QUEUE=disease.crawl-matrix
CRAWL_MATRIX_ARTICLE_WORKERS=3
TRANSLATION_PREFETCH=1
# RABBITMQ_SKDR_QUEUE=disease.skdr  # DETACHED with SKDR IBS/EBS
RABBITMQ_MANAGEMENT_PORT=15672


# NLP
NLP_MODEL=fine-tuned
MODEL_FAILURE_COOLDOWN_SECONDS=300
DISEASE_LABELS=
LOW_CONFIDENCE_THRESHOLD=0.5
ANALYZE_URL_USE_CACHE=true

# Optional multilingual bootstrap / normalization
# Leave DEEPSEEK_API_KEY empty to run only from existing DB data.

# NLLB is an auxiliary semantic view. Keep its interactive CPU budget bounded;
# original-language extraction remains authoritative for surveillance facts.
TRANSLATION_MAX_CHARS=2400
TRANSLATION_CHUNK_CHARS=700
TRANSLATION_MAX_CHUNKS=3
TRANSLATION_INTERACTIVE_MAX_CHARS=1200
TRANSLATION_INTERACTIVE_CHUNK_CHARS=600
TRANSLATION_INTERACTIVE_MAX_CHUNKS=1
TRANSLATION_INTERACTIVE_TIMEOUT_SECONDS=20
# Opt-in only for a separately budgeted review worker; never make crawling
# depend on an external LLM response.
AGENT_ENABLED=false
AGENT_PROVIDER_ORDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=400
DEEPSEEK_TRIGGER_CONFIDENCE=0.85
DEEPSEEK_LOCATION_MIN_CONFIDENCE=0.80
DEEPSEEK_LOCATION_MAX_CANDIDATES=80
DEEPSEEK_PROMPT_CHARS=16000
DEEPSEEK_RESPONSE_MAX_TOKENS=800
DEEPSEEK_DAILY_BUDGET=200
DEEPSEEK_FAILURE_COOLDOWN_SECONDS=120
DEEPSEEK_QUOTA_COOLDOWN_SECONDS=86400
# Set DEEPSEEK_DAILY_BUDGET=0 to disable LLM calls (kill switch) while keeping AGENT_ENABLED for future re-enable.
# SOURCE_CREDIBILITY_THRESHOLD=0.70
SOURCE_CREDIBILITY_THRESHOLD=0.70

# Native extraction remains authoritative. NLLB is an optional English view
# loaded lazily from the ./services/nlp-python/models volume.
TRANSLATION_LOCAL_ENABLED=true
TRANSLATION_PROVIDER=nllb
TRANSLATION_ASYNC_ENABLED=true
# Indonesian is extracted natively first; remove a language here to request
# the optional NLLB semantic view for it as well.
TRANSLATION_NATIVE_FIRST_LANGS=id
TRANSLATION_LOCAL_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_MAX_TOKENS=1800
# NLLB runs inside the NLP model container. These caps protect the model
# process on the 16 vCPU / 16 GiB VPS without changing crawler/worker limits.
NLLB_CPU_LIMIT=8.0
NLLB_MEMORY_LIMIT=6g
NLLB_PIDS_LIMIT=256
NLLB_OMP_NUM_THREADS=4
NLLB_MKL_NUM_THREADS=4
NLLB_OPENBLAS_NUM_THREADS=4
BOOTSTRAP_LLM_MIN_CONFIDENCE=0.85
BOOTSTRAP_LANGUAGES=id,ms,en,th,vi,km,lo,my,fil,tet,pt
CURRENT_YEAR_ONLY=true
# Optional override; empty uses the system year.
CURRENT_YEAR=

# Optional interactive URL analysis path. Keep disabled until staging checks
# pass; the frontend falls back to the legacy synchronous contract when false.
ANALYZE_URL_ASYNC_ENABLED=true
RABBITMQ_TRANSLATION_QUEUE=disease.translation
TRANSLATION_BACKGROUND_TIMEOUT_SECONDS=180
# Interactive HTML crawl budget. Keep this below reverse-proxy 504 limits.
# Stealth/browser fallback is skipped for URL analysis unless explicitly requested.
INTERACTIVE_HTML_TIMEOUT_SECONDS=30
INTERACTIVE_HTML_MAX_BOUND_MS=35000
INTERACTIVE_SKIP_STEALTH=true
# Async NLP stage budgets. Translation is intentionally capped to one short
# interactive window; original-language extraction remains the fast path.
TRANSLATION_STAGE_TIMEOUT_SECONDS=60
INFERENCE_STAGE_TIMEOUT_SECONDS=90
NLP_REQUEST_TIMEOUT_SECONDS=270
REANALYZE_BATCH_SIZE=50
REANALYSIS_STALE_SECONDS=300
MULTI_EVENT_LLM_FALLBACK=false
MULTI_EVENT_STAGE_TIMEOUT_SECONDS=20
# One shared source-text cap for manual URL and worker Full NLP requests.
NLP_INPUT_MAX_CHARS=35000

# Additive entity relation writers. Disable quickly if a production rollback
# is required after the corresponding migrations have been applied.
ENTITY_LOCATION_STORAGE_ENABLED=true
ENTITY_DISEASE_STORAGE_ENABLED=true

# SKDR IBS/EBS integrations are DETACHED. Do not set these until a later
# reattach. Routes return 410; the collector will not schedule skdr_api.
# SKDR_API_URL=
# SKDR_USER_KEY=
# SKDR_EBS_LIMIT=100
# SKDR_ALERT_LIMIT=500
# SKDR_REQUEST_DELAY_SECONDS=2
# SKDR_REQUEST_JITTER_SECONDS=0.5
# SKDR_MAX_RETRIES=5
# SKDR_BACKOFF_BASE_SECONDS=2
# SKDR_BACKOFF_MAX_SECONDS=60
# SKDR_REQUEST_TIMEOUT_SECONDS=60
# SKDR_MAX_REQUESTS_PER_RUN=500
# SKDR_ALERT_LOOKBACK_WEEKS=3
# SKDR_FETCH_TIME=00:00
# SKDR_RUN_ON_START=false
# SKDR_STARTUP_DELAY_SECONDS=10
COLLECTOR_TIMEZONE=Asia/Jakarta

# Training/retraining (host-side commands, never expose training credentials)
TRAINING_DATABASE_URL=postgres://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5435/disease_ai
TRAINING_MIN_CONFIDENCE=0.90
TRAINING_MAX_PER_LABEL=100000
TRAINING_MIN_MACRO_F1=0.80
TRAINING_MIN_EVAL_SAMPLES=100
TRAINING_MODEL_ROOT=services/nlp-python/models

# Optional WHO ICD-11 MMS canonical lookup.
# Register at https://icd.who.int/icdapi to obtain client credentials.
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
WHO_ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
WHO_ICD_API_URL=https://id.who.int
WHO_ICD_RELEASE=11/2026-01/mms
WHO_ICD_LANGUAGE=en
WHO_ICD_API_VERSION=v2
WHO_TERM_RESOLUTION_ENABLED=true

# Dedicated PDF routing is opt-in and keeps the existing HTML path unchanged.
PDF_ROUTING_ENABLED=true

# Social Media CSV Ingestion
SOCIAL_MEDIA_CSV_DIR=/app/data/social_media
SOCIAL_MEDIA_CSV_INTERVAL_MINUTES=5
SOCIAL_MEDIA_CSV_LOOP=true
SOCIAL_MEDIA_CSV_BATCH_SIZE=25

# === External Map Layer API Keys (optional) ===
# Layers work without these keys using public fallbacks (FIRMS SE Asia CSV,
# OSM Overpass, ReliefWeb). Set keys only to use the primary provider APIs.
NASA_FIRMS_MAP_KEY=       # Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key
HEALTHSITES_API_KEY=      # Free key from https://healthsites.io (OSM login)
