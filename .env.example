# PostgreSQL + PostGIS
POSTGRES_DB=disease_ai
POSTGRES_USER=disease_user
POSTGRES_PASSWORD=disease_pass
DATABASE_URL=postgres://disease_user:disease_pass@postgres:5432/disease_ai

# Backend
BACKEND_PORT=8080
RUST_LOG=info
NLP_SERVICE_URL=http://nlp-python:8000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=disease-documents

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2f
RABBITMQ_QUEUE=disease.raw
